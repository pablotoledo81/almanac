formulas:
  tree: 'if(branch.isEmpty(), "", branch.asFile().properties.tree)'
  due: 'if(!due_on.isEmpty() && due_on <= today(), "due", "")'
  dueRank: 'if(!due_on.isEmpty() && due_on <= today(), 0, 1)'
  stateRank: 'if(state == "Active", 0, if(state == "Blocked", 1, if(state == "Dormant", 2, if(state == "Done", 3, 4))))'
filters:
  and:
    - '!file.inFolder("Templates")'
    - 'type == "shoot"'
views:
  - type: table
    name: Active Shoots
    filters:
      and:
        - 'state == "Active"'
    groupBy:
      property: branch
      direction: ASC
    order: [file.name, formula.due, formula.tree, branch]
    sort:
      - property: formula.dueRank
        direction: ASC
      - property: due_on
        direction: ASC
  - type: table
    name: On this Branch
    filters:
      and:
        - file.hasLink(this.file)
        - 'state != "Done" && state != "Pruned"'
    order: [file.name, state, formula.due]
    sort:
      - property: formula.stateRank
        direction: ASC
  - type: table
    name: Dormant and Blocked
    filters:
      and:
        - 'state == "Dormant" || state == "Blocked"'
    groupBy:
      property: branch
      direction: ASC
    order: [file.name, state, formula.due, formula.tree, branch]
    sort:
      - property: formula.stateRank
        direction: ASC
  - type: table
    name: Finished
    filters:
      and:
        - 'state == "Done" || state == "Pruned"'
    order: [file.name, state, finished_on, formula.tree, branch]
    sort:
      - property: finished_on
        direction: DESC
