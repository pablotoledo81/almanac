formulas:
  visitDue: 'if(!next_visit_on.isEmpty() && next_visit_on < today(), "Visit due", "")'
filters:
  and:
    - '!file.inFolder("Templates")'
    - 'type == "tree"'
views:
  - type: table
    name: Trees
    order: [file.name, state, formula.visitDue, visited_on, next_visit_on, interval_days]
    sort:
      - property: next_visit_on
        direction: ASC
